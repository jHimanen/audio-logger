# Copy to .env and fill in. All values optional except ELEVENLABS_API_KEY when STT_PROVIDER=elevenlabs.
APP_LOCALE=fi
# Absolute or repo-relative path; defaults to <repo>/notes
NOTES_DIR=
ELEVENLABS_API_KEY=
# elevenlabs | fake   (fake returns canned text, no network, no key needed)
STT_PROVIDER=elevenlabs
# Upload limit in bytes; defaults to 50 MiB
MAX_UPLOAD_BYTES=
